<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="← Back"
            android:textSize="12sp"
            android:textColor="#0F172A"
            android:background="#E2E8F0" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Appearance"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Reset"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:background="#FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Subpage Item: Desktop Shortcuts -->
            <LinearLayout
                android:id="@+id/cardDesktopShortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_desktop_shortcuts"
                    android:contentDescription="Desktop Shortcuts" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Desktop Shortcuts"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#94A3B8"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- Interactive Live Keyboard Preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E2E8F0"
                android:padding="8dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE PREVIEW"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:layout_marginBottom="4dp"
                    android:layout_gravity="center_horizontal" />

                <com.example.ime.keyboard.VianKeyboardView
                    android:id="@+id/livePreviewKeyboard"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />
            </LinearLayout>

            <!-- Sliders Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF">

                <!-- 1. Key Height -->
                <TextView
                    android:id="@+id/tvHeightLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Key Height: 52 dp"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekKeyHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="35"
                    android:progress="17"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp" />

                <!-- 2. Corner Radius -->
                <TextView
                    android:id="@+id/tvRadiusLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Corner Radius: 10 dp"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekCornerRadius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="24"
                    android:progress="10"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp" />

                <!-- 3. Horizontal Gap -->
                <TextView
                    android:id="@+id/tvHGapLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Horizontal Gap: 5 dp"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekHGap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="14"
                    android:progress="5"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp" />

                <!-- 4. Vertical Gap -->
                <TextView
                    android:id="@+id/tvVGapLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vertical Gap: 5 dp"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekVGap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="14"
                    android:progress="5"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp" />

                <!-- 5. Special Keys Grey Tone -->
                <TextView
                    android:id="@+id/tvActionGrayLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Special Keys Grey: 40%"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekActionGray"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="40"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp" />

                <!-- 6. Enter Key Color -->
                <TextView
                    android:id="@+id/tvEnterColorLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter Key Color: 50%"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekEnterColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
