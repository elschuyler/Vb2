<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="← Back"
            android:textSize="12sp"
            android:textColor="#0F172A"
            android:background="#E2E8F0" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Log Keeper"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />

        <Switch
            android:id="@+id/swMasterLogger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- Memory Diagnostics Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM MEMORY HEALTH"
            android:textSize="11sp"
            android:textColor="#64748B"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMemoryStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Heap: -- MB / Max: -- MB"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Actions Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnCopyLogs"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Copy"
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:background="#E2E8F0"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnExportLogs"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Export"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="#0284C7"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnClearLogs"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Clear"
            android:textSize="13sp"
            android:textColor="#DC2626"
            android:background="#FEE2E2" />
    </LinearLayout>

    <!-- Filter Category Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/filterChipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="ALL"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="#0284C7"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/chipJni"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="JNI"
                android:textSize="11sp"
                android:textColor="#0F172A"
                android:background="#E2E8F0"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/chipDict"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="DICT"
                android:textSize="11sp"
                android:textColor="#0F172A"
                android:background="#E2E8F0"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/chipEngine"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="ENGINE"
                android:textSize="11sp"
                android:textColor="#0F172A"
                android:background="#E2E8F0"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/chipIme"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="IME"
                android:textSize="11sp"
                android:textColor="#0F172A"
                android:background="#E2E8F0"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/chipError"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="ERROR"
                android:textSize="11sp"
                android:textColor="#0F172A"
                android:background="#E2E8F0" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Log Viewer Output -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0F172A"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvLogContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#38BDF8"
            android:textSize="11.5sp"
            android:fontFamily="monospace"
            android:text="No logs recorded." />
    </ScrollView>

</LinearLayout>
