<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_canvas_background">

    <!-- Missing Model Warning Card (Matches Reference Screenshot) -->
    <LinearLayout
        android:id="@+id/llNoModelBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_voice_warning_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNoModelBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/voice_status_no_model_banner"
            android:textColor="#92400E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Import →"
            android:textColor="#B45309"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Auxiliary Quick Controls (Sensitivity Pill & Settings) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/tvGainPill"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:minWidth="40dp"
            android:background="@drawable/bg_voice_pill"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="1x"
            android:textColor="#334155"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnVoiceSettings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice Settings"
            android:scaleType="fitCenter"
            android:padding="5dp"
            android:tint="#475569"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Main Voice Control Capsule / Pulse Card (Matches Reference Screenshot) -->
    <LinearLayout
        android:id="@+id/llVoiceCard"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_voice_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <!-- Left: Circular Mic Action Button -->
        <ImageButton
            android:id="@+id/btnVoiceMic"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_voice_mic_circle"
            android:contentDescription="Microphone"
            android:scaleType="center"
            android:src="@drawable/ic_voice_mic_white" />

        <!-- Timer & Audio Status Text -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVoiceTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVoiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="90dp"
                android:text="@string/voice_status_listening"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Center: Dynamic Waveform Pulse View -->
        <com.example.ime.voice.VoicePulseView
            android:id="@+id/voicePulseView"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp" />

        <!-- Right: Cancel Recording Action -->
        <ImageButton
            android:id="@+id/btnVoiceCancel"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cancel Recording"
            android:scaleType="center"
            android:src="@drawable/ic_voice_cancel" />

        <!-- Right: Confirm / Commit Voice Input Action -->
        <ImageButton
            android:id="@+id/btnVoiceConfirm"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_voice_done_circle"
            android:contentDescription="Confirm Voice Input"
            android:scaleType="center"
            android:src="@drawable/ic_voice_check_white" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/toolbar_divider_color" />

    <!-- Unified 4-Button Modal Bottom Bar ([ABC] [Space] [Backspace] [Enter]) -->
    <com.example.ime.modal.ModalBottomBarView
        android:id="@+id/modalBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
