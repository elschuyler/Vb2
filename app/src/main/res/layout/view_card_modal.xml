<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/keyboard_canvas_background"
    android:orientation="vertical">

    <!-- Speed Island Header / Editing Toolbar -->
    <LinearLayout
        android:id="@+id/speedIslandBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@color/keyboard_canvas_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <!-- Cursor Navigation Arrows -->
        <ImageButton
            android:id="@+id/btnNavLeft"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cursor Left"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:tint="#000000"
            android:src="@drawable/ic_arrow_left" />

        <ImageButton
            android:id="@+id/btnNavRight"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cursor Right"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:tint="#000000"
            android:src="@drawable/ic_arrow_right" />

        <ImageButton
            android:id="@+id/btnNavUp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cursor Up"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:tint="#000000"
            android:src="@drawable/ic_arrow_up" />

        <ImageButton
            android:id="@+id/btnNavDown"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cursor Down"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:tint="#000000"
            android:src="@drawable/ic_arrow_down" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:background="@color/toolbar_divider_color" />

        <!-- Add Card button (Prompt List mode shortcut) -->
        <ImageButton
            android:id="@+id/btnAddCard"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Add Note"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:tint="#000000"
            android:src="@drawable/ic_add"
            android:visibility="gone" />

        <!-- Editing Tools -->
        <ImageButton
            android:id="@+id/btnSelectAll"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Select All"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:tint="#000000"
            android:src="@drawable/ic_select_all" />

        <ImageButton
            android:id="@+id/btnCut"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cut"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:tint="#000000"
            android:src="@drawable/ic_cut" />

        <ImageButton
            android:id="@+id/btnCopy"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Copy"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:tint="#000000"
            android:src="@drawable/sym_keyboard_copy_rounded" />

        <ImageButton
            android:id="@+id/btnPaste"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Paste"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:tint="#000000"
            android:src="@drawable/ic_paste" />

        <!-- Search Toggle Button -->
        <ImageButton
            android:id="@+id/btnToggleSearch"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Search filter"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:tint="#000000"
            android:src="@drawable/ic_search" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Clear Unpinned Items Button -->
        <ImageButton
            android:id="@+id/btnClearAll"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear Unpinned"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:tint="#000000"
            android:src="@drawable/ic_delete_sweep" />
    </LinearLayout>

    <!-- Search Filter Bar (Expandable) -->
    <LinearLayout
        android:id="@+id/llSearchBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#F1F5F9"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_search"
            android:tint="#64748B" />

        <EditText
            android:id="@+id/etSearchFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search cards..."
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnSearchClear"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear search"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            android:tint="#64748B" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/toolbar_divider_color" />

    <!-- Cards Container Area with 2-Column Grid -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCards"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tvEmptyPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="16dp"
            android:text="No cards available"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Unified 4-Button Modal Bottom Bar -->
    <com.example.ime.modal.ModalBottomBarView
        android:id="@+id/modalBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
